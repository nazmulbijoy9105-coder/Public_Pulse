rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    match /polls/{pollId} {
      allow read: if true;
      allow write: if request.auth != null;
      match /votes/{userId} {
        allow read, write: if request.auth != null;
      }
    }
    match /pending_questions/{id} {
      allow read, write: if request.auth != null;
    }
    match /test/connection {
      allow read: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
